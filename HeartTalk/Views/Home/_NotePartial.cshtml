@model HeartTalk.Models.Note

<div class="card-body">
    <p class="card-text" dir="rtl">@Model.Content</p>
    <p class="text-muted">Posted on: @Model.DatePosted</p>
    <p class="text-muted">Sympathy Count: @Model.SympathyCount</p>
    
    <!-- Form to increment sympathy count using AJAX -->
    <button class="btn btn-success" onclick="addSympathy(@Model.Id)">Like</button>

    <div class="m-3">
    @if (Model.Comments != null && Model.Comments.Any())
    {
        <p class="text-muted">Comments:</p>
        <ul>
            @foreach (var comment in Model.Comments)
            {
                <li>@comment.CommentText</li>
            }
        </ul>
    }
    </div>
    
    <form method="post" asp-controller="Home" asp-action="AddComment">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="text" name="CommentText" placeholder="Enter your comment" required />
        <button type="submit">Send Heart Comment</button>
    </form>

</div>